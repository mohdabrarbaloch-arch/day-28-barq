# Barq — environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Signing key for JWTs. REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production with the placeholder value below.
SECRET_KEY=change-me-generate-a-real-one

# development | production
# In production the app enforces a strong SECRET_KEY and enables HSTS.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres (docker-compose sets this automatically):
#   postgresql+psycopg://barq:barq@db:5432/barq
# Leave unset to fall back to SQLite at ./barq.db, which is fine for a single
# local process and wrong for anything with more than one worker.
# DATABASE_URL=postgresql+psycopg://barq:barq@localhost:5432/barq

# Echo every SQL statement to stdout. Noisy; development only.
SQL_ECHO=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# JWT lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# bcrypt cost factor. 12 is a sensible production default; the test suite
# lowers it to 4 so 77 tests do not spend a minute hashing.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the API from a browser.
# Never use * in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Requests per minute per IP, general endpoints.
RATE_LIMIT_PER_MINUTE=120

# Requests per minute per IP, /api/auth/* endpoints.
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Dispatch defaults
# ---------------------------------------------------------------------------

# Spinning reserve as a fraction of demand. 0.08 = 8%.
RESERVE_RATIO=0.08

# Minutes within which reserve must be deliverable. A unit that needs an hour
# to reach its headroom is not reserve.
RESERVE_WINDOW_MINUTES=10

# Nominal grid frequency in Hz. Pakistan uses 50.
NOMINAL_FREQUENCY_HZ=50.0
